    <!-- FIREBASE DATABASE SETUP (Replaces SQL) -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, addDoc, getDocs } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        window.initFirebaseDB = async () => {
            try {
                const appId = typeof __app_id !== 'undefined' ? __app_id : 'zalu-store';
                const configStr = typeof __firebase_config !== 'undefined' ? __firebase_config : null;
                
                if (!configStr) {
                    console.log("Duke u ekzekutuar në modalitet lokal (In-Memory). Databaza Reale është aktive vetëm në Canvas.");
                    return false;
                }

                const firebaseConfig = JSON.parse(configStr);
                const app = initializeApp(firebaseConfig);
                const auth = getAuth(app);
                const db = getFirestore(app);

                // Autentikimi i sigurtë i sistemit
                if (typeof __initial_auth_token !== 'undefined') {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }

                // Ekspozojmë funksionet e DB për t'i përdorur në React
                window.firebaseDb = db;
                window.firebaseAppId = appId;
                window.fbCollection = collection;
                window.fbAddDoc = addDoc;
                window.fbGetDocs = getDocs;
                
                console.log("✅ Databaza Reale (Firestore) u lidh me sukses!");
                return true;
            } catch (error) {
                console.error("Gabim në lidhjen me Databazën:", error);
                return false;
            }
        };
    </script>
