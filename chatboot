// Chatbot Logic
            useEffect(() => {
                if (chatEndRef.current) chatEndRef.current.scrollIntoView({ behavior: 'smooth' });
            }, [chatMessages, isChatOpen, isAiTyping]);

            const handleSendMessage = async (e) => {
                e.preventDefault();
                if (!chatInput.trim()) return;
                
                const userMsg = { sender: 'user', text: chatInput };
                const newMsgs = [...chatMessages, userMsg];
                setChatMessages(newMsgs);
                setChatInput('');
                setIsAiTyping(true);

                try {
                    const apiKey = ""; // Canvas e injekton vetë këtë në sfond
                    const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

                    // Formatojmë historikun e bisedës për AI
                    const geminiHistory = newMsgs.map(msg => ({
                        role: msg.sender === 'ai' ? 'model' : 'user',
                        parts: [{ text: msg.text }]
                    }));

                    // Krijojmë katalogun si tekst për AI në mënyrë që të dijë çmimet dhe masat
                    const catalogInfo = MOCK_PRODUCTS.map(p => `- ${p.title} (${p.category}): $${p.price.toFixed(2)}. Masat: ${p.sizes.join(', ')}`).join('\n');

                    // Instruktimet e sistemit për Chatbotin
                    const systemPrompt = `Ti je Zalu AI, asistenti inteligjent i dyqanit premium ZALU DESIGNER.
Përgjigju SHKURT, QARTË dhe NË SHQIP. Jepi prioritet mirësjelljes.
Informacione për dyqanin:
1. Transporti: Transport falas për porosi mbi $500. Për porosi nën $500, transporti kushton $25. Dorëzimi në 2-3 ditë pune kudo në botë.
2. KATALOGU DHE ÇMIMET: Këtu është lista e saktë e të gjitha produkteve që kemi në dyqan, bashkë me çmimet dhe masat e disponueshme:
${catalogInfo}

RREGULLAT: 
- Nëse klienti pyet "Sa kushton X?", shiko listën më sipër dhe tregoji çmimin e saktë dhe masat.
- Nëse klienti pyet "A keni masa për X?", tregoji masat nga lista.
- Sugjero produkte specifike nga lista nëse klienti kërkon rekomandime (p.sh. fustane, kostume, atlete).`;

                    const payload = {
                        contents: geminiHistory,
                        systemInstruction: { parts: [{ text: systemPrompt }] }
                    };

                    const response = await fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const result = await response.json();
                    
                    if (result.candidates && result.candidates.length > 0) {
                        const reply = result.candidates[0].content.parts[0].text;
                        setChatMessages(prev => [...prev, { sender: 'ai', text: reply }]);
                    } else {
                        setChatMessages(prev => [...prev, { sender: 'ai', text: "Më falni, po has vështirësi në gjetjen e informacionit për momentin." }]);
                    }
                } catch (error) {
                    console.error("AI Error:", error);
                    setChatMessages(prev => [...prev, { sender: 'ai', text: "Më falni, ndodhi një problem me lidhjen. Provoni sërish pas pak." }]);
                } finally {
                    setIsAiTyping(false);
                }
            };

            return (
                <div className="min-h-screen flex flex-col selection:bg-gold selection:text-white relative">
                    {/* Toast Notification */}
                    {toast && (
                        <div className="fixed top-24 left-1/2 transform -translate-x-1/2 bg-black text-white px-6 py-3 rounded shadow-2xl z-[100] animate-in flex items-center gap-2">
                            <Icon.Check size={18} className="text-gold"/> {toast}
                        </div>
                    )}

                    {}
                    <header className="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-gray-100">
                        <div className="container mx-auto px-4 h-20 flex items-center justify-between">
                            <button className="lg:hidden" onClick={() => setIsMobileMenuOpen(!isMobileMenuOpen)}>
                                {isMobileMenuOpen ? <Icon.X size={24} /> : <Icon.Menu size={24} />}
                            </button>

                            <div className="flex-1 lg:flex-none text-center lg:text-left cursor-pointer" onClick={() => navigate('home')}>
                                <h1 className="text-2xl font-bold tracking-widest uppercase">Zalu<span className="text-gold">.</span></h1>
                            </div>

                            <nav className="hidden lg:flex gap-8 text-sm uppercase tracking-wider font-medium text-gray-500">
                                <button onClick={() => navigate('home')} className={`hover:text-black transition-colors ${currentView === 'home' ? 'text-black' : ''}`}>Home</button>
                                <button onClick={() => navigate('shop')} className={`hover:text-black transition-colors ${currentView === 'shop' ? 'text-black' : ''}`}>Shop</button>
                                <button onClick={() => navigate('shop')} className="hover:text-black transition-colors">Collections</button>
                            </nav>

                            <div className="flex items-center gap-4 lg:gap-6">
                                <button onClick={() => navigate('shop')}><Icon.Search size={20} className="hover:text-gold transition-colors"/></button>
                                <button onClick={() => user ? navigate('profile') : navigate('auth')}>
                                    {user ? <div className="w-7 h-7 bg-black text-white rounded-full flex items-center justify-center text-xs font-bold">{user.name.charAt(0)}</div> : <Icon.User size={20} className="hover:text-gold transition-colors"/>}
                                </button>
                                <button className="relative" onClick={() => navigate('cart')}>
                                    <Icon.ShoppingBag size={20} className="hover:text-gold transition-colors"/>
                                    {cart.length > 0 && (
                                        <span className="absolute -top-2 -right-2 bg-black text-white text-[10px] w-4 h-4 flex items-center justify-center rounded-full">
                                            {cart.length}
                                        </span>
                                    )}
                                </button>
                            </div>
                        </div>

                        {isMobileMenuOpen && (
                            <div className="lg:hidden absolute top-20 left-0 w-full bg-white border-b border-gray-100 py-4 px-4 flex flex-col gap-4 shadow-xl">
                                <button onClick={() => navigate('home')} className="text-left py-2 border-b border-gray-50 uppercase tracking-wider">Home</button>
                                <button onClick={() => navigate('shop')} className="text-left py-2 border-b border-gray-50 uppercase tracking-wider">Shop</button>
                                <button onClick={() => user ? navigate('profile') : navigate('auth')} className="text-left py-2 uppercase tracking-wider">Account</button>
                            </div>
                        )}
                    </header>

                    {}
                    <main className="flex-grow">
                        {currentView === 'home' && <HomeView navigate={navigate} />}
                        {currentView === 'shop' && <ShopView navigate={navigate} />}
                        {currentView === 'product' && <ProductDetailView product={selectedProduct} navigate={navigate} addToCart={addToCart} toggleWishlist={toggleWishlist} wishlist={wishlist} />}
                        {currentView === 'cart' && <CartView cart={cart} removeFromCart={removeFromCart} navigate={navigate} />}
                        {currentView === 'checkout' && <CheckoutView cart={cart} navigate={navigate} setCart={setCart} dbReady={dbReady} user={user} />}
                        {currentView === 'auth' && <AuthView navigate={navigate} setUser={setUser} dbReady={dbReady} />}
                        {currentView === 'profile' && <ProfileView user={user} setUser={setUser} navigate={navigate} />}
                    </main>

                    {/* Footer */}
                    <footer className="bg-gray-50 pt-20 pb-10 border-t border-gray-200 mt-20">
                        <div className="container mx-auto px-4 grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
                            <div>
                                <h2 className="text-xl font-bold tracking-widest uppercase mb-6">Zalu<span className="text-gold">.</span></h2>
                                <p className="text-gray-500 text-sm leading-relaxed">Elevating everyday luxury. Your destination for premium, curated fashion pieces.</p>
                            </div>
                            <div>
                                <h3 className="font-bold uppercase tracking-wider mb-6 text-sm">Shop</h3>
                                <ul className="space-y-3 text-sm text-gray-500">
                                    <li><button onClick={()=>navigate('shop')} className="hover:text-black">New Arrivals</button></li>
                                    <li><button onClick={()=>navigate('shop')} className="hover:text-black">Women</button></li>
                                    <li><button onClick={()=>navigate('shop')} className="hover:text-black">Men</button></li>
                                </ul>
                            </div>
                            <div>
                                <h3 className="font-bold uppercase tracking-wider mb-6 text-sm">Help</h3>
                                <ul className="space-y-3 text-sm text-gray-500">
                                    <li><button className="hover:text-black">Customer Service</button></li>
                                    <li><button className="hover:text-black">Shipping & Returns</button></li>
                                </ul>
                            </div>
                            <div>
                                <h3 className="font-bold uppercase tracking-wider mb-6 text-sm">Newsletter</h3>
                                <div className="flex border-b border-black pb-2 mt-4">
                                    <input type="email" placeholder="Email address" className="bg-transparent outline-none flex-grow text-sm" />
                                    <button className="uppercase text-xs font-bold tracking-wider hover:text-gold">Subscribe</button>
                                </div>
                            </div>
                        </div>
                    </footer>

                    {}
                    <div className="fixed bottom-6 right-6 z-50">
                        {isChatOpen && (
                            <div className="bg-white border border-gray-200 rounded-lg shadow-2xl w-[350px] max-w-[90vw] mb-4 overflow-hidden flex flex-col h-[450px] animate-in">
                                <div className="bg-black text-white p-4 flex justify-between items-center shadow-md z-10">
                                    <div className="flex items-center gap-3">
                                        <div className="w-8 h-8 bg-gold rounded-full flex items-center justify-center font-bold text-black">Z</div>
                                        <div><h4 className="font-bold leading-tight">Zalu AI</h4><p className="text-xs text-gray-300">Asistenti i Blerjeve</p></div>
                                    </div>
                                    <button onClick={() => setIsChatOpen(false)} className="hover:text-gold transition-colors"><Icon.X size={20} /></button>
                                </div>
                                <div className="flex-grow p-4 overflow-y-auto bg-gray-50 flex flex-col gap-3 text-sm">
                                    {chatMessages.map((msg, index) => (
                                        <div key={index} className={`max-w-[85%] p-3 rounded-xl shadow-sm ${msg.sender === 'ai' ? 'bg-white border border-gray-100 self-start rounded-tl-none text-gray-800' : 'bg-black text-white self-end rounded-tr-none'}`}>
                                            {msg.text}
                                        </div>
                                    ))}
                                    {isAiTyping && (
                                        <div className="bg-white border border-gray-100 p-3 rounded-xl rounded-tl-none self-start shadow-sm flex gap-1 items-center max-w-[85%]">
                                            <div className="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style={{animationDelay: '0s'}}></div>
                                            <div className="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style={{animationDelay: '0.2s'}}></div>
                                            <div className="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style={{animationDelay: '0.4s'}}></div>
                                        </div>
                                    )}
                                    <div ref={chatEndRef} />
                                </div>
                                <form onSubmit={handleSendMessage} className="p-3 bg-white border-t border-gray-100 flex items-center gap-2">
                                    <input type="text" value={chatInput} onChange={(e) => setChatInput(e.target.value)} placeholder="Shkruaj një mesazh..." className="flex-grow text-sm outline-none bg-gray-100 p-3 rounded-full px-4 border border-transparent focus:border-gray-300 transition-colors" />
                                    <button type="submit" disabled={!chatInput.trim()} className="bg-black text-white p-3 rounded-full hover:bg-gold transition-colors disabled:bg-gray-300"><Icon.Send size={18} /></button>
                                </form>
                            </div>
                        )}
                        <button onClick={() => setIsChatOpen(!isChatOpen)} className="bg-black text-white p-4 rounded-full shadow-2xl hover:scale-105 transition-transform hover:bg-gold flex items-center justify-center">
                            {isChatOpen ? <Icon.X size={28} /> : <Icon.MessageCircle size={28} />}
                        </button>
                    </div>
                </div>
            );
        }

        function HomeView({ navigate }) {
            const trendingProducts = MOCK_PRODUCTS.slice(0, 4);
            return (
                <div className="animate-in">
                    <section className="relative h-[80vh] flex items-center justify-center bg-gray-900 overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=2000&q=80" alt="Hero" className="absolute inset-0 w-full h-full object-cover opacity-70" />
                        <div className="relative z-10 text-center text-white p-4">
                            <h2 className="text-sm md:text-base tracking-[0.3em] uppercase mb-4 font-light text-gold drop-shadow-md">New Collection 2026</h2>
                            <h1 className="text-5xl md:text-7xl font-bold uppercase tracking-wider mb-8 drop-shadow-lg">Redefine <br/>Luxury</h1>
                            <button onClick={() => navigate('shop')} className="bg-white text-black px-10 py-4 uppercase tracking-widest text-sm font-bold hover:bg-gold hover:text-white transition-all duration-300 shadow-xl">Shop Now</button>
                        </div>
                    </section>
                    
                    <section className="py-20 container mx-auto px-4">
                        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                            {['Women', 'Men', 'Accessories'].map((cat, i) => (
                                <div key={i} className="relative h-[400px] group cursor-pointer overflow-hidden" onClick={() => navigate('shop')}>
                                    <img src={[
                                        "https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=800&q=80",
                                        "https://images.unsplash.com/photo-1617137968427-85924c800a22?auto=format&fit=crop&w=800&q=80",
                                        "https://images.unsplash.com/photo-1549298916-b41d501d3772?auto=format&fit=crop&w=800&q=80"
                                    ][i]} 
                                    onError={(e) => { e.target.onerror = null; e.target.src = 'https://placehold.co/800x1200/f3f4f6/a1a1aa?text=' + cat; }}
                                    className="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" alt={cat} />
                                    <div className="absolute inset-0 bg-black/20 group-hover:bg-black/40 transition-colors duration-300 flex items-center justify-center">
                                        <h3 className="text-white text-2xl uppercase tracking-widest font-bold">{cat}</h3>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </section>

                    <section className="py-16 bg-gray-50">
                        <div className="container mx-auto px-4">
                            <div className="flex justify-between items-end mb-10">
                                <div><h2 className="text-3xl font-bold uppercase tracking-wider">Trending Now</h2></div>
                                <button onClick={() => navigate('shop')} className="hidden md:flex items-center gap-2 uppercase text-sm font-bold hover:text-gold transition-colors">View All <Icon.ChevronRight size={16} /></button>
                            </div>
                            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
                                {trendingProducts.map(p => <ProductCard key={p.id} product={p} navigate={navigate} />)}
                            </div>
                        </div>
                    </section>
                </div>
            );
        }
