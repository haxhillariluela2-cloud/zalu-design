            if (!product) return null;
            const [selectedSize, setSelectedSize] = useState(product.sizes[0]);
            const [selectedColor, setSelectedColor] = useState(product.colors[0]);
            const [isImageOpen, setIsImageOpen] = useState(false);
            const isWishlisted = wishlist.some(p => p.id === product.id);

            return (
                <div className="container mx-auto px-4 py-8 md:py-16 animate-in">
                    {/* Dritarja e Zmadhimit të Fotos (Modal) */}
                    {isImageOpen && (
                        <div className="fixed inset-0 z-[100] bg-black/95 flex items-center justify-center p-4 animate-in" onClick={() => setIsImageOpen(false)}>
                            <button className="absolute top-6 right-6 text-white hover:text-gold transition-colors" onClick={() => setIsImageOpen(false)}>
                                <Icon.X size={32} />
                            </button>
                            <img 
                                src={product.images[0]} 
                                alt={product.title} 
                                onError={(e) => { e.target.onerror = null; e.target.src = 'https://placehold.co/800x1200/f3f4f6/a1a1aa?text=' + encodeURIComponent(product.title); }}
                                className="max-w-full max-h-[90vh] object-contain zoom-in" 
                                onClick={(e) => e.stopPropagation()} 
                            />
                        </div>
                    )}

                    <button onClick={() => navigate('shop')} className="mb-8 text-sm uppercase tracking-wider flex items-center gap-2 text-gray-500 hover:text-black"><Icon.ChevronLeft size={16} /> Back to Shop</button>
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20">
                        <div className="aspect-[3/4] bg-gray-100 overflow-hidden shadow-sm cursor-zoom-in group" onClick={() => setIsImageOpen(true)} title="Kliko për ta zmadhuar">
                            <img 
                                src={product.images[0]} 
                                alt={product.title} 
                                onError={(e) => { e.target.onerror = null; e.target.src = 'https://placehold.co/800x1200/f3f4f6/a1a1aa?text=' + encodeURIComponent(product.title); }}
                                className="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
                            />
                        </div>
                        <div className="flex flex-col justify-center">
                            <div className="mb-2 text-sm uppercase tracking-widest text-gray-500">{product.category}</div>
                            <h1 className="text-3xl md:text-4xl font-bold uppercase tracking-wider mb-4">{product.title}</h1>
                            <div className="text-2xl font-light mb-6">${product.price.toFixed(2)}</div>
                            <div className="flex items-center gap-2 mb-8 text-gold">
                                {[...Array(5)].map((_, i) => <Icon.Star key={i} size={16} fill={i < Math.floor(product.rating) ? "currentColor" : "none"} />)}
                                <span className="text-gray-500 text-sm ml-2">({product.reviews} reviews)</span>
                            </div>
                            <p className="text-gray-600 leading-relaxed mb-8">{product.description}</p>
                            
                            <div className="mb-6">
                                <h3 className="text-sm font-bold uppercase tracking-wider mb-3">Color: {selectedColor}</h3>
                                <div className="flex gap-3">
                                    {product.colors.map(c => (
                                        <button key={c} onClick={() => setSelectedColor(c)} className={`w-8 h-8 rounded-full border-2 ${selectedColor === c ? 'border-black' : 'border-transparent'} ring-1 ring-gray-200`} style={{backgroundColor: c.toLowerCase() === 'champagne' ? '#F7E7CE' : (c.includes('/') ? c.split('/')[0].toLowerCase() : c.split(' ')[0].toLowerCase())}} title={c} />
                                    ))}
                                </div>
                            </div>
                            
                            <div className="mb-10">
                                <h3 className="text-sm font-bold uppercase tracking-wider mb-3">Size: {selectedSize}</h3>
                                <div className="grid grid-cols-4 gap-3">
                                    {product.sizes.map(s => (
                                        <button key={s} onClick={() => setSelectedSize(s)} className={`py-3 border uppercase text-sm tracking-wider transition-colors ${selectedSize === s ? 'border-black bg-black text-white' : 'border-gray-200 hover:border-black'}`}>{s}</button>
                                    ))}
                                </div>
                            </div>
                            
                            <div className="flex gap-4 mb-10">
                                <button onClick={() => addToCart(product, selectedSize, selectedColor)} className="flex-grow bg-black text-white uppercase tracking-widest font-bold py-4 hover:bg-gold transition-colors">Add to Cart</button>
                                <button onClick={() => toggleWishlist(product)} className={`p-4 border border-gray-200 hover:border-black transition-colors ${isWishlisted ? 'text-red-500' : 'text-gray-400'}`}><Icon.Heart size={24} fill={isWishlisted ? "currentColor" : "none"} /></button>
                            </div>
                        </div>
                    </div>
                </div>
            );
        }

